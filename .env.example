# TZ FX BOT — copy to .env on the host. Never commit real values.
# CGI reads sibling files too: .telegram_token and a Gemini key file.

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# Public webhook (must match the CGI path)
WEBHOOK_URL=https://ehsantz.pingbaz.space/bot/index.cgi

# Telegram ids — public channels, not secrets
# Bot: @TZ_FX_BOT
# Free channel: @TZ_FX_CH
# VIP invite is set in the bot, not here.

# Live desk. Mode must stay demo until you intentionally go live.
LIVE_MODE=demo

# Owner Telegram numeric id (admin /pay confirm)
# OWNER_ID=8351722954
