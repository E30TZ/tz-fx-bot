# TZ FX BOT — copy to .env on the host. Never commit real values.
# CGI also reads sibling files: .telegram_token and the mentor key file.

TELEGRAM_BOT_TOKEN=

# Mentor text/speech key — host file, never git
GEMINI_API_KEY=

# Public webhook (must match the deployed path)
WEBHOOK_URL=https://ehsantz.pingbaz.space/bot/index.cgi

# Public channels — not secrets
# Bot: @TZ_FX_BOT
# Free channel: @TZ_FX_CH

# Desk execution. Stay on demo until you change it on purpose.
LIVE_MODE=demo

# Owner Telegram numeric id (admin / receipt confirm)
# OWNER_ID=8351722954
